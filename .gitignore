# telangana-agromet — .gitignore
# Rationale: data blobs stay out of git; reproducibility is carried by the
# manifests + checksums under data/manifests/, which ARE tracked.  README
# section 4 explains why the separation is deliberate.

# ---------------------------------------------------------------- OS / editor
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.vscode/
.idea/

# ------------------------------------------------------- Python environment
.venv/
venv/
env/
.python-version
__pycache__/
*.py[cod]
*$py.class
*.so
.mypy_cache/
.pytest_cache/
.ruff_cache/
.dmypy.json

# --------------------------------------------------------------- Notebooks
.ipynb_checkpoints/

# ------------------------------------------------------------- Data blobs
# Raw is immutable and append-only, but it is not committed. The SHA-256 of every
# raw file is recorded in data/manifests/checksums.sha256 instead.
/data/raw/
/data/interim/
/data/processed/

# The user-supplied DES attachment. It is copied into data/raw/des/ by
# the README workflow copies it there and checksums it; committing both copies
# would duplicate ~1 MB of the same blob. Provenance lives in the manifest.
/data/*.xls
/data/*.xlsx
/data/*.csv

# TRACKED on purpose (do not add these to the ignore list):
#   data/manifests/   fetch_manifest.json, checksums.sha256, BLOCKERS.md
#   data/geo/         districts.csv, districts.geojson, PARTITION_NOTE.md
#   DATA_VERSION
#   figures/          the published F1-F7, cited by README section 6
#   dashboard/data/   the served bundle; the page opens from disk with no build

# README.md               the report of record: method, results, limitations

# Stray spreadsheet lock files from Excel/Numbers on macOS
~$*
.~lock.*

# ----------------------------------------------------------- Secrets (C4/C5)
# This project needs none. The rule exists so none can appear.
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.json

# ------------------------------------------------- Dashboard / site build
node_modules/
dashboard/_site/
dashboard/.cache/
.vite/
*.log

# --------------------------------------------------------- Logs & scratch
logs/
*.log
tmp/
scratch/
*.tmp
*.bak
*.swp
.~*.swx

# ------------------------------------------------- Stray files and scratch
# Editor and shell droppings that have no business in a published tree.
core
core.*
*.orig
*.rej
*.swx
*.log.[0-9]
/*.bak
/.DS_Store
**/.DS_Store
._*
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.cache/
.cache

# Large generated binaries anywhere (belt-and-braces; normally already
# excluded by the /data/ rules above)
*.parquet
*.feather
*.joblib
*.pkl
*.h5
*.nc
*.zip
*.tar.gz
